        </button>
      </div>

      <div class="stats">
        <div class="stat-box">⚡ Livraison Instantanée</div>
        <div class="stat-box">🔒 Paiement Sécurisé</div>
        <div class="stat-box">🌍 Disponible Partout</div>
      </div>
    </div>
  </section>

  <section class="services">
    <div class="section-title">
